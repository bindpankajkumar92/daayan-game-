{
  "name": "daayans-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daayan's House — first-person horror escape game. Three.js + TypeScript + Capacitor for Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:build:apk": "cd android && gradlew assembleDebug",
    "cap:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@gltf-transform/cli": "^4.0.0",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
