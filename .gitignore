# Dependencies
node_modules/

# Build output
dist/
*.log

# Capacitor
.capacitor/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Editor temp
.vite/
*.tsbuildinfo
# Vite's throwaway ESM copy of the config, left behind once per run; `npm run dev` makes a new one anyway.
vite.config.ts.timestamp-*.mjs

# Headless Chrome profiles the live probes run in, and the vite pid `tools/_cdplive.mjs stop` reads back.
# The plain `.chromeprof/` above is an older one; these are named with a suffix, so the glob has to have one.
.chromeprof*/
.vite-live.pid
# Scratch dumps from a probe session, all of them named `.tmp-*` by hand.
.tmp-*

# Environment
.env
.env.local
.env.*.local

# Heavy assets / backups
glb files/
.models-backup-0.8/
audio files/
device-shot.png

# Scratch: one-off asset-inspection scripts and the images they dump. Dot-prefixed by hand so they
# sort out of the way; several also import `sharp`, which is not a dependency, so they would not run
# from a fresh clone anyway.
tools/.*.mjs
# Bundle output from `npm run check:ai` — regenerated on every run, never worth committing.
tools/.tmp/
.tmp-img*.webp

# Stale build output kept aside by the safe-delete shim during a rebuild.
.dist-old-verify/
.vid2/
.dist-old-verify2/
.dist-old-verify3/
.dist-old-verify4/
.dist-old-verify5/
.dist-old-verify6/
.dist-old-verify7/
.dist-old-verify8/
.look/
.chromeprof/
.dist-old-v9/
.dist-old-v10/
.dist-old-v11/

# Screenshots and image dumps from debugging and probe sessions. They stay on disk; none of them ship with the game.
shots/
.thresh/
.r7/
tmp_frames/
tools/_furn/
tools/*.png
/device-*.png
/fist_look_*.png
/tmp-*.png
# One-off scratch scripts at the repo root.
/tmp-*.mjs
